# Authentication OTP Mode
# Options: 'mock' (default for development with test OTP '1234') or 'whatsapp' (production Meta Cloud API)
AUTH_OTP_MODE=mock

# Real WhatsApp Business Cloud API Credentials (Required only when AUTH_OTP_MODE=whatsapp)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en

# Server Port
PORT=3000
